{
  "name": "fdpg-webapp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "vite -c vite.config.app.ts --port 8080",
    "dev:print": "vite -c vite.config.print.ts ./src/print-module --port 8081",
    "build": "vue-tsc --noEmit && vite -c vite.config.app.ts build",
    "build:print": "vue-tsc --noEmit && vite -c vite.config.print.ts build && npm run rename-print-index",
    "rename-print-index": "node -e \"require('fs').rename('print-frontend/index.print.html', 'print-frontend/index.html', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "preview": "vite preview --port 8080",
    "test:unit": "vitest --coverage",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "i18n:build": "node ./src/scripts/build-lang-files.js && prettier --parser json-stringify --write src/locales/*.json && node ./src/scripts/auto-fix-translation-files.js",
    "i18n:report": "vue-cli-service i18n:report --src \"./src/**/*.?(js|vue)\" --locales \"./src/locales/**/*.json\"",
    "prebuild": "npm run i18n:build",
    "auto-fix-translations": "node src/scripts/auto-fix-translation-files.js"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.0",
    "@fortawesome/fontawesome-free": "^6.7.1",
    "@headlessui/vue": "^1.7.23",
    "@testing-library/user-event": "^14.6.1",
    "@vueuse/core": "^13.5.0",
    "axios": "^1.10.0",
    "quill": "^2.0.3",
    "bootstrap-icons": "^1.13.1",
    "element-plus": "^2.10.4",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "public-google-sheets-parser": "^1.5.4",
    "tslib": "^2.8.1",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.10",
    "vue-oidc-client": "^1.0.0-alpha.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "6.0.8",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.54.1",
    "@rushstack/eslint-patch": "^1.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.3",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "resolutions": {
    "minimatch": "^9.0.5",
    "eslint-visitor-keys": "^4.2.0"
  }
}
